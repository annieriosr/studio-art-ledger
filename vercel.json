{
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install --omit=dev",
  "rewrites": [
    { "source": "/api/sales", "destination": "/api/sales" },
    { "source": "/api/confirm-sale", "destination": "/api/confirm-sale" },
    { "source": "/api/site-state", "destination": "/api/site-state" },
