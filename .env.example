PORT=3000

# Required on Vercel (production) so phone/desktop saves stick on the live site.
# Choose any passphrase Annie will enter once as "Clave de guardado" on:
# bills, booth tracker, outreach, and the studio book.
# Powers /api/sales, /api/confirm-sale, /api/site-state, /api/publish-drafts.
LEDGER_WRITE_TOKEN=

# GitHub personal access token (contents:write on annieriosr/studio-art-ledger).
# Used by /api/sales and /api/confirm-sale on Vercel to commit data/cosas-sales.json
# and update data/ledger.json + injected catalogue HTML.
# Prefer LEDGER_GITHUB_TOKEN; GITHUB_TOKEN / GH_TOKEN also accepted.
LEDGER_GITHUB_TOKEN=

# Optional overrides
# GITHUB_REPO=annieriosr/studio-art-ledger
# GITHUB_BRANCH=main
# SALES_FORCE_GITHUB=1
# GITHUB_TOKEN=

